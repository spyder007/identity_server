{
  "ConnectionStrings": {
    "IdentityConnection": ""
  },
  "Logging": {
    "OpenTelemetry": {
      "IncludeFormattedMessage": true,
      "IncludeScopes": true,
      "ParseStateValues": true
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning",
        "Spydersoft.Identity": "Debug"
      }
    }
  },
  "Telemetry": {
    "Log": {
      "Type": "none"
    },
    "Metrics": {
      "Type": "console"
    },
    "Trace": {
      "Type": "console"
    }
  }
}